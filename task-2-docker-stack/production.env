# =============================================================================
# Environment Variables for Production Deployments
# Usage: Copy to .env.production and set sensitive values securely
# =============================================================================
# Database Configuration
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme_in_prod_use_secrets_manager
POSTGRES_DB=appdb

# API Configuration
DEBUG=false
LOG_LEVEL=INFO

# JWT Secret Generation (run once, store in secrets manager)
# Python: python -c "from cryptography.fernet import fernet; print(fernet.generate_key())"
JWT_SECRET_KEY=<generate-with-secrets-manager>

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
